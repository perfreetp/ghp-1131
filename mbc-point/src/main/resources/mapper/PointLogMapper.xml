<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartretail.mbc.point.mapper.PointLogMapper">

    <resultMap id="BaseResultMap" type="com.smartretail.mbc.point.entity.PointLog">
        <id column="id" property="id"/>
        <result column="member_id" property="memberId"/>
        <result column="point_type" property="pointType"/>
        <result column="change_points" property="changePoints"/>
        <result column="before_points" property="beforePoints"/>
        <result column="after_points" property="afterPoints"/>
        <result column="frozen_points" property="frozenPoints"/>
        <result column="source_type" property="sourceType"/>
        <result column="source_id" property="sourceId"/>
        <result column="expire_time" property="expireTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, member_id, point_type, change_points, before_points, after_points,
        frozen_points, source_type, source_id, expire_time, remark,
        create_time, create_by, update_time, update_by, is_deleted
    </sql>

    <select id="selectExpiringPoints" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_point_log
        WHERE member_id = #{memberId}
          AND point_type = 1
          AND expire_time IS NOT NULL
          AND expire_time &lt;= DATE_ADD(NOW(), INTERVAL #{days} DAY)
          AND expire_time &gt; NOW()
          AND is_deleted = 0
        ORDER BY expire_time ASC
    </select>

    <select id="selectTotalByType" resultType="java.lang.Integer">
        SELECT COALESCE(SUM(change_points), 0)
        FROM t_point_log
        WHERE member_id = #{memberId}
          AND point_type = #{pointType}
          AND is_deleted = 0
    </select>

</mapper>
