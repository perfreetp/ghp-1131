<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartretail.mbc.query.mapper.ActivityBudgetMapper">

    <resultMap id="BaseResultMap" type="com.smartretail.mbc.query.entity.ActivityBudget">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="store_code" property="storeCode"/>
        <result column="store_name" property="storeName"/>
        <result column="budget_type" property="budgetType"/>
        <result column="total_budget" property="totalBudget"/>
        <result column="used_budget" property="usedBudget"/>
        <result column="issue_limit" property="issueLimit"/>
        <result column="issued_count" property="issuedCount"/>
        <result column="redeem_limit" property="redeemLimit"/>
        <result column="redeemed_count" property="redeemedCount"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, activity_id, store_code, store_name, budget_type, total_budget, used_budget,
        issue_limit, issued_count, redeem_limit, redeemed_count, status,
        create_time, update_time, create_by, update_by, is_deleted
    </sql>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_activity_budget
        WHERE activity_id = #{activityId}
          AND is_deleted = 0
        ORDER BY budget_type ASC, store_code ASC
    </select>

    <select id="selectByActivityAndStore" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_activity_budget
        WHERE activity_id = #{activityId}
          AND store_code = #{storeCode}
          AND is_deleted = 0
        LIMIT 1
    </select>

</mapper>
