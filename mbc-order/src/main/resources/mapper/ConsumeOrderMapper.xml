<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartretail.mbc.order.mapper.ConsumeOrderMapper">

    <resultMap id="BaseResultMap" type="com.smartretail.mbc.order.entity.ConsumeOrder">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="member_id" property="memberId"/>
        <result column="order_type" property="orderType"/>
        <result column="order_status" property="orderStatus"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="coupon_amount" property="couponAmount"/>
        <result column="point_amount" property="pointAmount"/>
        <result column="level_discount" property="levelDiscount"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="earned_points" property="earnedPoints"/>
        <result column="earned_growth" property="earnedGrowth"/>
        <result column="used_points" property="usedPoints"/>
        <result column="used_coupon_ids" property="usedCouponIds"/>
        <result column="store_code" property="storeCode"/>
        <result column="store_name" property="storeName"/>
        <result column="pos_code" property="posCode"/>
        <result column="cashier" property="cashier"/>
        <result column="pay_time" property="payTime"/>
        <result column="complete_time" property="completeTime"/>
        <result column="refund_time" property="refundTime"/>
        <result column="refund_no" property="refundNo"/>
        <result column="refund_amount" property="refundAmount"/>
        <result column="channel" property="channel"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, member_id, order_type, order_status, total_amount, discount_amount,
        coupon_amount, point_amount, level_discount, pay_amount, earned_points, earned_growth,
        used_points, used_coupon_ids, store_code, store_name, pos_code, cashier, pay_time,
        complete_time, refund_time, refund_no, refund_amount, channel, remark, create_time,
        create_by, update_time, update_by, is_deleted
    </sql>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_consume_order
        WHERE order_no = #{orderNo}
          AND is_deleted = 0
    </select>

    <update id="updateOrderStatus">
        UPDATE t_consume_order
        SET order_status = #{newStatus},
            update_time = NOW()
        WHERE order_no = #{orderNo}
          AND order_status = #{oldStatus}
          AND is_deleted = 0
    </update>

</mapper>
